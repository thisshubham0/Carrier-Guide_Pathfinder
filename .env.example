# GEMINI_API_KEY: Required for server-side Gemini AI mentor & career explanation synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (used for shareable parent/counsellor links).
APP_URL="MY_APP_URL"

# PATHFINDER_DEFAULT_REGION: Optional default region preset (global | in | us). Defaults to "global".
PATHFINDER_DEFAULT_REGION="global"

# PATHFINDER_DB_PATH: Optional SQLite file path. Defaults to ./data/pathfinder.sqlite.
PATHFINDER_DB_PATH="./data/pathfinder.sqlite"
